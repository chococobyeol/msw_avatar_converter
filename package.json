{
  "name": "msw-avatar-converter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "psd:inventory": "tsx scripts/psd-inventory.ts",
    "psd:roundtrip": "tsx scripts/psd-roundtrip.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts tests/unit/*.test.tsx",
    "fixtures:validate": "tsx scripts/validate-fixtures.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test:ui": "tsx --test tests/unit/ui.test.tsx"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "ag-psd": "^30.1.1",
    "canvas": "^3.2.3",
    "lucide-react": "^1.17.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^6.4.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.17.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
